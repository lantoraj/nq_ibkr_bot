# ============================================================================
# Interactive Brokers (IB Gateway) & NQ Bot Cloud Configuration (.env)
# Copy this file to `.env` on your DigitalOcean Droplet:
#   cp .env.example .env && nano .env
# ============================================================================

# Your IBKR Username and Password
TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password

# Trading mode: "paper" or "live"
TRADING_MODE=paper

# IB Gateway internal port: 4002 for paper, 4001 for live
IB_GATEWAY_PORT=4002

# Strategy & Risk parameters
BOT_SYMBOL=MNQ
BOT_BAR_SIZE=2 mins
BOT_CONTRACTS=1
BOT_MAX_DAILY_LOSS=250.0
BOT_CLIENT_ID=101

# Optional Discord Webhook URL for live trade entry/exit/stop notifications
DISCORD_WEBHOOK_URL=

